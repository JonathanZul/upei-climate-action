# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored; this file is committed and must never contain secrets.

# --- Sanity.io ---
# Found in sanity.io/manage, or in the sibling upei-climate-action-cms repo config.
NEXT_PUBLIC_SANITY_PROJECT_ID="YOUR_SANITY_PROJECT_ID"
NEXT_PUBLIC_SANITY_DATASET="production"

# Shared secret for the on-demand revalidation webhook (app/api/revalidate).
# Must match the secret configured on the webhook in sanity.io/manage.
SANITY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# Write token used only to increment the QR scan counter (app/qr).
# Create in sanity.io/manage -> API -> Tokens with "Editor" permission.
# Optional: without it the redirect still works, it just stops counting scans.
SANITY_API_WRITE_TOKEN="YOUR_SANITY_WRITE_TOKEN"

# --- Resend (contact form) ---
RESEND_API_KEY="YOUR_RESEND_API_KEY"
CONTACT_FORM_EMAIL_TO="where-contact-form-submissions-go@example.com"

# --- Beehiiv (newsletter) ---
BEEHIIV_API_KEY="YOUR_BEEHIIV_API_KEY"
BEEHIIV_PUBLICATION_ID="YOUR_BEEHIIV_PUBLICATION_ID"
